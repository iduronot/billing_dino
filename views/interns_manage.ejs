<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .intern-card{background:var(--card-bg);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:20px;}
        table{width:100%;border-collapse:collapse;}
        th{background:var(--sub-bg);color:var(--muted);font-size:11px;font-weight:600;text-transform:uppercase;padding:10px 14px;text-align:left;}
        td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:middle;}
        tr:last-child td{border-bottom:none;}
        .badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
        .badge-active{background:rgba(16,185,129,.12);color:#10B981;}
        .badge-finished{background:rgba(148,163,184,.12);color:#94A3B8;}
        .btn-act{padding:5px 10px;border-radius:7px;border:1px solid var(--border);background:var(--sub-bg);color:var(--text);cursor:pointer;font-size:11px;text-decoration:none;display:inline-flex;align-items:center;gap:4px;}
        .btn-act:hover{background:var(--border);}
        .btn-act.cert{background:rgba(245,158,11,.12);color:#F59E0B;border-color:rgba(245,158,11,.3);}
        .btn-act.del{background:rgba(239,68,68,.1);color:#EF4444;border-color:rgba(239,68,68,.3);}
        .alert{padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:16px;}
        .alert-ok{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#10B981;}
        .alert-err{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#EF4444;}
        .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center;padding:20px;}
        .modal-card{background:var(--card-bg);border:1px solid var(--border);border-radius:16px;padding:24px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;}
        .modal-card h3{margin:0 0 18px;font-size:17px;}
        .form-group{margin-bottom:14px;}
        .form-group label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:5px;}
        .form-control{width:100%;padding:9px 12px;border-radius:9px;border:1px solid var(--border);background:var(--sub-bg);color:var(--text);font-size:13px;font-family:inherit;box-sizing:border-box;}
        .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
        .btn{padding:9px 18px;border-radius:9px;border:none;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
        .btn-primary{background:linear-gradient(135deg,#3B82F6,#2563EB);color:#fff;}
        .btn-ghost{background:var(--sub-bg);color:var(--text);border:1px solid var(--border);}
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/topbar', { title: 'Siswa Magang' }) %>
    <div class="content">

        <% if (msg) { %><div class="alert alert-ok">✅ <%= msg %></div><% } %>
        <% if (err) { %><div class="alert alert-err">❌ <%= err %></div><% } %>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
            <div>
                <h1 class="page-title" style="margin:0;">🎓 Manajemen Siswa Magang</h1>
                <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Kelola akun, rekap logbook & presensi, serta cetak sertifikat</p>
            </div>
            <div style="display:flex;gap:8px;">
                <a href="/interns/logbook" class="btn-act">📔 Logbook</a>
                <a href="/interns/attendance" class="btn-act">📍 Presensi</a>
                <button class="btn btn-primary" onclick="openAddModal()">➕ Tambah Siswa</button>
            </div>
        </div>

        <div class="intern-card">
            <table>
                <thead><tr>
                    <th style="width:44px;">No</th><th>Nama</th><th>Username</th><th>Sekolah/Kampus</th><th>Jurusan</th>
                    <th>Periode</th><th>Pembimbing</th><th>Status</th><th>Aksi</th>
                </tr></thead>
                <tbody>
                <% if (interns.length === 0) { %>
                    <tr><td colspan="9" style="text-align:center;color:var(--muted);padding:40px;">
                        Belum ada siswa magang — klik <b>➕ Tambah Siswa</b> untuk membuat akun pertama
                    </td></tr>
                <% } %>
                <% interns.forEach((it, idx) => { %>
                <tr>
                    <td style="color:var(--muted);font-weight:600;"><%= idx + 1 %></td>
                    <td style="font-weight:700;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="width:34px;height:34px;border-radius:50%;overflow:hidden;background:var(--sub-bg);display:inline-flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;border:1px solid var(--border);">
                                <% if (it.photo) { %><img src="<%= it.photo %>" style="width:100%;height:100%;object-fit:cover;" alt=""><% } else { %>🎓<% } %>
                            </span>
                            <%= it.full_name %>
                        </div>
                    </td>
                    <td style="font-family:monospace;font-size:12px;"><%= it.username %></td>
                    <td><%= it.school || '-' %></td>
                    <td><%= it.major || '-' %></td>
                    <td style="font-size:12px;color:var(--muted);">
                        <%= it.start_date ? new Date(it.start_date+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) : '?' %>
                        s.d.
                        <%= it.end_date ? new Date(it.end_date+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) : '?' %>
                    </td>
                    <td><%= it.mentor || '-' %></td>
                    <td><span class="badge badge-<%= it.status %>"><%= it.status === 'active' ? 'Aktif' : 'Selesai' %></span></td>
                    <td style="white-space:nowrap;">
                        <a href="/interns/detail/<%= it.id %>" class="btn-act" title="Lihat detail">👁️</a>
                        <a href="/interns/certificate/<%= it.id %>" class="btn-act cert" target="_blank" title="Cetak sertifikat">📜</a>
                        <button class="btn-act" onclick='openEditModal(<%- JSON.stringify(it) %>)' title="Edit">✏️</button>
                        <button class="btn-act del" onclick="delIntern(<%= it.id %>, '<%= it.full_name.replace(/'/g, "\\'") %>')" title="Hapus">🗑️</button>
                    </td>
                </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- Modal Tambah -->
<div class="modal-overlay" id="addModal">
    <div class="modal-card">
        <h3>➕ Tambah Siswa Magang</h3>
        <form onsubmit="return saveIntern(event, null)">
            <div class="form-row">
                <div class="form-group"><label>Nama Lengkap *</label><input class="form-control" id="addName" required></div>
                <div class="form-group"><label>Username Login *</label><input class="form-control" id="addUsername" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Password *</label><input class="form-control" id="addPassword" type="password" required minlength="6"></div>
                <div class="form-group"><label>Pembimbing</label><input class="form-control" id="addMentor"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Sekolah / Kampus</label><input class="form-control" id="addSchool"></div>
                <div class="form-group"><label>Jurusan</label><input class="form-control" id="addMajor"></div>
            </div>
            <div class="form-group"><label>Email (Gmail untuk login Google — opsional)</label><input class="form-control" id="addEmail" type="email" placeholder="nama@gmail.com"></div>
            <div class="form-row">
                <div class="form-group"><label>Tanggal Mulai</label><input class="form-control" id="addStart" type="date"></div>
                <div class="form-group"><label>Tanggal Selesai</label><input class="form-control" id="addEnd" type="date"></div>
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" onclick="document.getElementById('addModal').style.display='none'">Batal</button>
                <button type="submit" class="btn btn-primary">💾 Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit -->
<div class="modal-overlay" id="editModal">
    <div class="modal-card">
        <h3>✏️ Edit Siswa Magang</h3>
        <form onsubmit="return saveIntern(event, editId)">
            <input type="hidden" id="editId">
            <div class="form-group"><label>Nama Lengkap *</label><input class="form-control" id="editName" required></div>
            <div class="form-group"><label>Email (Gmail untuk login Google)</label><input class="form-control" id="editEmail" type="email" placeholder="nama@gmail.com"></div>
            <div class="form-row">
                <div class="form-group"><label>Sekolah / Kampus</label><input class="form-control" id="editSchool"></div>
                <div class="form-group"><label>Jurusan</label><input class="form-control" id="editMajor"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Tanggal Mulai</label><input class="form-control" id="editStart" type="date"></div>
                <div class="form-group"><label>Tanggal Selesai</label><input class="form-control" id="editEnd" type="date"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Pembimbing</label><input class="form-control" id="editMentor"></div>
                <div class="form-group"><label>Status</label>
                    <select class="form-control" id="editStatus">
                        <option value="active">Aktif</option>
                        <option value="finished">Selesai</option>
                    </select>
                </div>
            </div>
            <div class="form-group"><label>Reset Password (kosongkan jika tidak diganti)</label><input class="form-control" id="editPassword" type="password" minlength="6" placeholder="••••••"></div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" onclick="document.getElementById('editModal').style.display='none'">Batal</button>
                <button type="submit" class="btn btn-primary">💾 Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<script>
let editId = null;
function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
function openEditModal(it) {
    editId = it.id;
    document.getElementById('editId').value = it.id;
    document.getElementById('editName').value = it.full_name;
    document.getElementById('editEmail').value = it.email || '';
    document.getElementById('editSchool').value = it.school || '';
    document.getElementById('editMajor').value = it.major || '';
    document.getElementById('editStart').value = it.start_date ? it.start_date.toISOString ? it.start_date.toISOString().slice(0,10) : String(it.start_date).slice(0,10) : '';
    document.getElementById('editEnd').value = it.end_date ? (it.end_date.toISOString ? it.end_date.toISOString().slice(0,10) : String(it.end_date).slice(0,10)) : '';
    document.getElementById('editMentor').value = it.mentor || '';
    document.getElementById('editStatus').value = it.status;
    document.getElementById('editPassword').value = '';
    document.getElementById('editModal').style.display = 'flex';
}

async function saveIntern(ev, id) {
    ev.preventDefault();
    const isAdd = !id;
    const body = isAdd ? {
        username: document.getElementById('addUsername').value.trim(),
        password: document.getElementById('addPassword').value,
        full_name: document.getElementById('addName').value.trim(),
        school: document.getElementById('addSchool').value.trim(),
        major: document.getElementById('addMajor').value.trim(),
        start_date: document.getElementById('addStart').value || null,
        end_date: document.getElementById('addEnd').value || null,
        mentor: document.getElementById('addMentor').value.trim(),
        email: document.getElementById('addEmail').value.trim()
    } : {
        full_name: document.getElementById('editName').value.trim(),
        email: document.getElementById('editEmail').value.trim(),
        school: document.getElementById('editSchool').value.trim(),
        major: document.getElementById('editMajor').value.trim(),
        start_date: document.getElementById('editStart').value || null,
        end_date: document.getElementById('editEnd').value || null,
        mentor: document.getElementById('editMentor').value.trim(),
        status: document.getElementById('editStatus').value,
        password: document.getElementById('editPassword').value || undefined
    };
    const res = await fetch(isAdd ? '/interns/api' : '/interns/api/' + id, {
        method: isAdd ? 'POST' : 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(body)
    });
    const d = await res.json();
    if (d.success) { location.href = '/interns?msg=' + encodeURIComponent(d.message); }
    else { alert('❌ ' + d.message); }
    return false;
}

async function delIntern(id, name) {
    if (!confirm(`Hapus siswa magang "${name}" beserta seluruh data presensi & logbook-nya?`)) return;
    const res = await fetch('/interns/api/' + id, { method: 'DELETE' });
    const d = await res.json();
    if (d.success) location.href = '/interns?msg=' + encodeURIComponent(d.message);
    else alert('❌ ' + d.message);
}
</script>
</body>
</html>
