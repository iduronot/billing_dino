<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ganti Password — <%= (settings && settings.company_name) || 'Portal Pelanggan' %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: linear-gradient(135deg, #0B0F19 0%, #111827 100%);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            color: #F8FAFC; padding: 20px;
        }
        .card {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px; padding: 36px 32px;
            width: 100%; max-width: 400px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }
        .icon { font-size: 44px; text-align: center; margin-bottom: 12px; }
        h1 { font-size: 20px; font-weight: 700; text-align: center; margin-bottom: 8px; }
        p.desc { font-size: 13px; color: #94A3B8; text-align: center; margin-bottom: 24px; line-height: 1.6; }
        label { display: block; font-size: 12px; font-weight: 600; color: #94A3B8; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        input {
            width: 100%; padding: 12px 14px; margin-bottom: 16px;
            background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px; color: #F8FAFC; font-size: 14px; outline: none;
        }
        input:focus { border-color: #3B82F6; }
        button {
            width: 100%; padding: 13px; border: none; border-radius: 10px;
            background: linear-gradient(135deg, #3B82F6, #6366F1);
            color: white; font-size: 14px; font-weight: 600; cursor: pointer;
        }
        button:hover { opacity: 0.9; }
        .error {
            background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.35);
            color: #FCA5A5; font-size: 13px; border-radius: 10px;
            padding: 10px 14px; margin-bottom: 16px; text-align: center;
        }
        .logout { display: block; text-align: center; margin-top: 18px; font-size: 12px; color: #64748B; text-decoration: none; }
        .logout:hover { color: #94A3B8; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">🔐</div>
        <h1>Ganti Password</h1>
        <p class="desc">Halo <strong><%= user.customerName || 'Pelanggan' %></strong>, demi keamanan akun, Anda wajib mengganti password default sebelum melanjutkan.</p>

        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form method="POST" action="/portal/first-login">
            <label for="new_password">Password Baru (min. 6 karakter)</label>
            <input type="password" id="new_password" name="new_password" required minlength="6" autocomplete="new-password">
            <label for="confirm_password">Ulangi Password Baru</label>
            <input type="password" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password">
            <button type="submit">Simpan &amp; Lanjutkan</button>
        </form>

        <a class="logout" href="/portal/logout">← Bukan akun Anda? Logout</a>
    </div>
</body>
</html>
