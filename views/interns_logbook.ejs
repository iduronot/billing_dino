<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .lb-card{background:var(--card-bg);border:1px solid var(--border);border-radius:16px;overflow:hidden;}
        table{width:100%;border-collapse:collapse;}
        th{background:var(--sub-bg);color:var(--muted);font-size:11px;font-weight:600;text-transform:uppercase;padding:10px 14px;text-align:left;}
        td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:top;}
        tr:last-child td{border-bottom:none;}
        .form-control{padding:8px 12px;border-radius:9px;border:1px solid var(--border);background:var(--sub-bg);color:var(--text);font-size:13px;font-family:inherit;}
        .lb-act{white-space:pre-wrap;line-height:1.5;}
        .lb-prob{color:#F59E0B;font-size:12px;margin-top:6px;}
        .lb-prob::before{content:'⚠️ Kendala: ';font-weight:600;}
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/topbar', { title: 'Rekap Logbook Magang' }) %>
    <div class="content">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
            <div>
                <h1 class="page-title" style="margin:0;">📔 Rekap Logbook Harian</h1>
                <p style="margin:4px 0 0;font-size:13px;color:var(--muted);"><%= logs.length %> entri logbook</p>
            </div>
            <a href="/interns" class="btn-act">← Kembali ke Kelola Siswa</a>
        </div>

        <div class="lb-card" style="margin-bottom:16px;">
            <form method="GET" style="display:flex;gap:10px;padding:14px 16px;flex-wrap:wrap;align-items:center;">
                <select name="user_id" class="form-control">
                    <option value="">👥 Semua Siswa</option>
                    <% interns.forEach(it => { %>
                    <option value="<%= it.user_id || '' %>" <%= String(userId) === String(it.user_id) ? 'selected' : '' %>><%= it.full_name %></option>
                    <% }) %>
                </select>
                <input type="month" name="month" value="<%= month %>" class="form-control">
                <button type="submit" class="btn btn-primary" style="padding:8px 18px;border-radius:9px;border:none;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;">🔍 Filter</button>
            </form>
        </div>

        <div class="lb-card">
            <table>
                <thead><tr><th style="width:130px;">Tanggal</th><th style="width:180px;">Siswa</th><th>Kegiatan Hari Ini</th></tr></thead>
                <tbody>
                <% if (logs.length === 0) { %>
                    <tr><td colspan="3" style="text-align:center;color:var(--muted);padding:40px;">Tidak ada logbook untuk filter ini</td></tr>
                <% } %>
                <% logs.forEach(l => { %>
                <tr>
                    <td style="font-weight:600;white-space:nowrap;">
                        <%= new Date(l.log_date+'T00:00:00').toLocaleDateString('id-ID',{weekday:'short',day:'2-digit',month:'short',year:'numeric'}) %>
                    </td>
                    <td>
                        <div style="font-weight:600;"><%= l.full_name %></div>
                        <div style="font-size:11px;color:var(--muted);"><%= l.school || '' %></div>
                    </td>
                    <td>
                        <div class="lb-act"><%= l.activities %></div>
                        <% if (l.problems) { %><div class="lb-prob"><%= l.problems %></div><% } %>
                    </td>
                </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>
</body>
</html>
