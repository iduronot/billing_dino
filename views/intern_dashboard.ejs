<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .checkin-card{background:var(--card-bg);border:1px solid var(--border);border-radius:20px;padding:28px;text-align:center;max-width:440px;margin:0 auto 24px;}
        .checkin-status{font-size:64px;margin-bottom:12px;line-height:1;}
        .checkin-title{font-size:20px;font-weight:800;margin-bottom:4px;}
        .checkin-sub{font-size:14px;color:var(--muted);margin-bottom:20px;}
        .checkin-info{background:var(--sub-bg);border-radius:12px;padding:14px;margin-bottom:18px;text-align:left;}
        .ci-row{display:flex;justify-content:space-between;font-size:13px;padding:4px 0;}
        .ci-label{color:var(--muted);}
        .ci-val{font-weight:600;}
        .btn-checkin{width:100%;padding:16px;border-radius:14px;border:none;font-size:16px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s;}
        .btn-checkin.ready{background:linear-gradient(135deg,#10B981,#059669);color:white;box-shadow:0 6px 20px rgba(16,185,129,.4);}
        .btn-checkin.ready:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(16,185,129,.4);}
        .btn-checkin.done{background:var(--sub-bg);color:var(--muted);cursor:not-allowed;border:1px solid var(--border);}
        .result-card{border-radius:14px;padding:16px;margin-bottom:14px;text-align:center;display:none;}
        .result-card.success{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);color:#10B981;}
        .result-card.error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#EF4444;}
        .result-card.late{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);color:#F59E0B;}

        .stats-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px;}
        .sm-card{background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center;}
        .sm-val{font-size:24px;font-weight:800;}
        .sm-label{font-size:11px;color:var(--muted);margin-top:2px;}

        .card{background:var(--card-bg);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:20px;}
        .card-head{padding:14px 18px;border-bottom:1px solid var(--border);font-weight:700;font-size:15px;}
        .card-body{padding:18px;}
        .form-group{margin-bottom:14px;}
        .form-group label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.4px;}
        .form-control{width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--border);background:var(--input-bg,var(--sub-bg));color:var(--text);font-size:14px;font-family:'Outfit',sans-serif;box-sizing:border-box;}
        textarea.form-control{min-height:90px;resize:vertical;}
        .btn-primary{padding:12px 24px;border-radius:12px;border:none;background:linear-gradient(135deg,#3B82F6,#2563EB);color:#fff;font-size:14px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;}

        table{width:100%;border-collapse:collapse;}
        th{background:var(--sub-bg);color:var(--muted);font-size:11px;font-weight:600;text-transform:uppercase;padding:10px 14px;text-align:left;}
        td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:top;}
        tr:last-child td{border-bottom:none;}
        .btn-del{padding:4px 10px;border-radius:8px;border:1px solid rgba(239,68,68,.3);background:rgba(239,68,68,.1);color:#EF4444;font-size:11px;cursor:pointer;font-weight:700;}
        .badge-day{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;background:var(--sub-bg);color:var(--muted);}
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/topbar', { title: 'Dashboard Magang' }) %>
    <div class="content">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
            <div>
                <h1 class="page-title" style="margin:0;">🎓 Halo, <%= intern.full_name || user.username %>!</h1>
                <div id="liveClock" style="font-size:13px;color:var(--muted);margin-top:4px;"></div>
                <% if (intern.school) { %>
                <div style="font-size:13px;color:var(--muted);margin-top:2px;">
                    <%= intern.school %><% if (intern.major) { %> · <%= intern.major %><% } %>
                    <% if (intern.mentor) { %> · Pembimbing: <%= intern.mentor %><% } %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Card Presensi -->
        <div class="checkin-card">
            <% if (todayAttendance) { %>
                <div class="checkin-status"><%= todayAttendance.status==='hadir'?'✅':todayAttendance.status==='terlambat'?'🟡':'❌' %></div>
                <div class="checkin-title"><%= todayAttendance.status==='hadir'?'Sudah Hadir':todayAttendance.status==='terlambat'?'Terlambat':'Ditolak' %></div>
                <div class="checkin-sub">Presensi hari ini sudah tercatat</div>
                <div class="checkin-info">
                    <div class="ci-row"><span class="ci-label">Waktu Masuk</span><span class="ci-val"><%= new Date(todayAttendance.check_in_time).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',second:'2-digit'}) %></span></div>
                    <div class="ci-row"><span class="ci-label">Jarak dari Kantor</span><span class="ci-val"><%= todayAttendance.distance_m %>m</span></div>
                    <div class="ci-row"><span class="ci-label">Status</span><span class="ci-val" style="color:<%=todayAttendance.status==='hadir'?'#10B981':todayAttendance.status==='terlambat'?'#F59E0B':'#EF4444'%>;"><%= todayAttendance.status.toUpperCase() %></span></div>
                </div>
                <button class="btn-checkin done" disabled>✓ Presensi Selesai Hari Ini</button>
            <% } else { %>
                <div class="checkin-status">📍</div>
                <div class="checkin-title">Presensi Sekarang</div>
                <div class="checkin-sub">
                    Radius maks. <strong><%= cfg.attendance_radius || 100 %>m</strong> dari titik kantor<br>
                    Batas tepat waktu: <strong><%= cfg.attendance_late_time || '08:30' %></strong>
                </div>
                <div id="resultCard" class="result-card"></div>
                <div class="checkin-info" id="gpsInfo">
                    <div class="ci-row"><span class="ci-label">Status GPS</span><span class="ci-val" id="gpsStatusText" style="color:#F59E0B;">Belum diakses</span></div>
                    <div class="ci-row"><span class="ci-label">Koordinat</span><span class="ci-val" id="coordText" style="font-size:11px;">-</span></div>
                    <div class="ci-row"><span class="ci-label">Akurasi</span><span class="ci-val" id="accText">-</span></div>
                </div>
                <button class="btn-checkin ready" id="btnCheckin" onclick="doCheckin()">
                    📍 Ambil GPS & Presensi Sekarang
                </button>
            <% } %>
        </div>

        <!-- Stats mini -->
        <div class="stats-mini">
            <div class="sm-card"><div class="sm-val" style="color:#10B981;"><%= attStats.hadir||0 %></div><div class="sm-label">✅ Tepat Waktu</div></div>
            <div class="sm-card"><div class="sm-val" style="color:#F59E0B;"><%= attStats.terlambat||0 %></div><div class="sm-label">🟡 Terlambat</div></div>
            <div class="sm-card"><div class="sm-val" style="color:#3B82F6;"><%= logTotal %></div><div class="sm-label">📖 Logbook</div></div>
        </div>

        <!-- Form Logbook Hari Ini -->
        <div class="card">
            <div class="card-head">📖 Logbook Hari Ini</div>
            <div class="card-body">
                <div id="lbResult" class="result-card"></div>
                <form id="logbookForm">
                    <div class="form-group">
                        <label>Kegiatan yang dikerjakan *</label>
                        <textarea class="form-control" name="activities" required placeholder="Contoh: Membantu instalasi FO di pelanggan Pak Budi, konfigurasi OLT..."><%= todayLog ? todayLog.activities : '' %></textarea>
                    </div>
                    <div class="form-group">
                        <label>Kendala / Catatan (opsional)</label>
                        <textarea class="form-control" name="problems" placeholder="Kendala yang dihadapi jika ada..."><%= todayLog ? (todayLog.problems || '') : '' %></textarea>
                    </div>
                    <button type="submit" class="btn-primary" id="btnSaveLog">
                        <%= todayLog ? '✏️ Update Logbook Hari Ini' : '💾 Simpan Logbook Hari Ini' %>
                    </button>
                    <% if (todayLog) { %><span style="font-size:12px;color:var(--muted);margin-left:10px;">Sudah tersimpan — submit lagi untuk mengubah</span><% } %>
                </form>
            </div>
        </div>

        <!-- Riwayat Logbook Bulan Ini -->
        <div class="card">
            <div class="card-head">📅 Riwayat Logbook Bulan <%= new Date(month+'-02T00:00:00').toLocaleDateString('id-ID',{month:'long',year:'numeric'}) %></div>
            <table>
                <thead><tr><th style="width:120px;">Tanggal</th><th>Kegiatan</th><th style="width:220px;">Kendala/Catatan</th><th style="width:70px;"></th></tr></thead>
                <tbody>
                <% const DAYS=['Min','Sen','Sel','Rab','Kam','Jum','Sab']; %>
                <% if(logs.length>0){ logs.forEach(l => { const d=new Date(l.log_date+'T00:00:00'); %>
                <tr>
                    <td style="white-space:nowrap;">
                        <span class="badge-day"><%= DAYS[d.getDay()] %></span>
                        <%= d.toLocaleDateString('id-ID',{day:'2-digit',month:'short'}) %>
                    </td>
                    <td><%= l.activities %></td>
                    <td style="color:var(--muted);font-size:12px;"><%= l.problems || '—' %></td>
                    <td><button class="btn-del" onclick="delLog(<%= l.id %>, this)">Hapus</button></td>
                </tr>
                <% }) }else{ %>
                <tr><td colspan="4" style="text-align:center;color:var(--muted);padding:40px;">Belum ada logbook bulan ini</td></tr>
                <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
function updateClock() {
    const now = new Date();
    const DAYS = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    const MONTHS = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    document.getElementById('liveClock').textContent =
        `${DAYS[now.getDay()]}, ${now.getDate()} ${MONTHS[now.getMonth()]} ${now.getFullYear()} — ${now.toLocaleTimeString('id-ID')}`;
}
updateClock(); setInterval(updateClock, 1000);

let userLat = null, userLng = null, userAcc = null;

<% if (!todayAttendance) { %>
navigator.geolocation && navigator.geolocation.getCurrentPosition(
    pos => {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        userAcc = Math.round(pos.coords.accuracy);
        document.getElementById('gpsStatusText').textContent = '✅ Siap';
        document.getElementById('gpsStatusText').style.color = '#10B981';
        document.getElementById('coordText').textContent = `${userLat.toFixed(6)}, ${userLng.toFixed(6)}`;
        document.getElementById('accText').textContent = `±${userAcc}m`;
    },
    err => {
        const msgs = {1:'GPS ditolak — izinkan di pengaturan browser', 2:'Sinyal GPS lemah', 3:'Waktu habis'};
        document.getElementById('gpsStatusText').textContent = '❌ ' + (msgs[err.code]||err.message);
        document.getElementById('gpsStatusText').style.color = '#EF4444';
    },
    { enableHighAccuracy:true, timeout:15000, maximumAge:0 }
);
<% } %>

async function doCheckin() {
    const btn = document.getElementById('btnCheckin');
    const resultCard = document.getElementById('resultCard');
    if (!userLat || !userLng) {
        btn.textContent = '📡 Mengambil GPS...';
        btn.disabled = true;
        navigator.geolocation.getCurrentPosition(
            pos => { userLat=pos.coords.latitude; userLng=pos.coords.longitude; userAcc=Math.round(pos.coords.accuracy); btn.disabled=false; btn.textContent='📍 Ambil GPS & Presensi Sekarang'; doCheckin(); },
            () => { btn.disabled=false; btn.textContent='📍 Ambil GPS & Presensi Sekarang'; showResult('GPS tidak tersedia. Izinkan akses lokasi di browser.','error'); }
        );
        return;
    }
    btn.textContent = '⏳ Memproses presensi...';
    btn.disabled = true;
    const res = await fetch('/attendance/api/checkin', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ lat: userLat, lng: userLng, device_info: navigator.userAgent.substring(0,150) })
    });
    const d = await res.json();
    if (d.success) {
        const cls = d.status === 'terlambat' ? 'late' : 'success';
        showResult(d.message, cls);
        btn.className = 'btn-checkin done';
        btn.textContent = '✓ Presensi Berhasil';
        setTimeout(() => location.reload(), 2000);
    } else {
        showResult(d.message, 'error');
        btn.disabled = false;
        btn.textContent = '📍 Ambil GPS & Presensi Sekarang';
    }
}

function showResult(msg, type) {
    const card = document.getElementById('resultCard');
    card.textContent = msg;
    card.className = 'result-card ' + type;
    card.style.display = 'block';
}

// Logbook
document.getElementById('logbookForm').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = document.getElementById('btnSaveLog');
    const fd = new FormData(e.target);
    btn.disabled = true; btn.textContent = '⏳ Menyimpan...';
    const res = await fetch('/intern/api/logbook', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ activities: fd.get('activities'), problems: fd.get('problems') })
    });
    const d = await res.json();
    const card = document.getElementById('lbResult');
    card.textContent = d.message;
    card.className = 'result-card ' + (d.success ? 'success' : 'error');
    card.style.display = 'block';
    btn.disabled = false;
    btn.textContent = d.success ? '✏️ Update Logbook Hari Ini' : '💾 Simpan Logbook Hari Ini';
    if (d.success) setTimeout(() => location.reload(), 1500);
});

async function delLog(id, btn) {
    if (!confirm('Hapus logbook ini?')) return;
    btn.disabled = true;
    const res = await fetch('/intern/api/logbook/' + id, { method:'DELETE' });
    const d = await res.json();
    if (d.success) location.reload();
    else { alert(d.message); btn.disabled = false; }
}
</script>
</body>
</html>
